# Copy to .env.production.local (local builds / `pnpm deploy`) and set the same value in Netlify.
# Public reCAPTCHA Enterprise *site* key from Google Cloud → Fraud Defense, registered in Firebase → App Check.
# Never put the reCAPTCHA secret here: the secret stays in Firebase App Check only.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
